include LICENSE README.md CONTRIBUTING.md pyproject.toml setup.py requirements.txt
include docs/POSE_API.md docs/MODEL_SCALING.md docs/PACKAGE_MIGRATION.md docs/ROADMAP.md docs/PUBLISHING.md
recursive-include aruco_pose *.py
recursive-include tests *.py
recursive-include examples *.py *.md
recursive-include tools *.py *.md
recursive-include config *.json
recursive-include assets/starter *.json *.svg *.csv *.mp4
global-exclude __pycache__ *.py[cod] desktop.ini
recursive-include scripts *.py
recursive-include site *.html *.css *.js *.svg *.jpg *.mp4 *.json
